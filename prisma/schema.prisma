datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user {
  telegram_id      Decimal    @id @db.Decimal(60, 0)
  is_premium       Boolean
  username         String?    @db.VarChar
  photoUrl         String?    @db.VarChar
  ref_code         String     @unique @db.VarChar
  ref_by           String?    @db.VarChar
  fuel_tank_lv     Int        @default(0)
  turbo_changer_lv Int        @default(0)
  activites        activity[]
}

model activity {
  id          Int      @id @default(autoincrement())
  points      Float
  activity    String   @db.VarChar(26)
  date        DateTime @default(now()) @db.Timestamptz(3)
  telegram_id Decimal  @db.Decimal(60, 0)
  user        user     @relation(fields: [telegram_id], references: [telegram_id])
  friend_id   Decimal? @db.Decimal(60, 0) // case activity = invite_friend
  root_id     Int?     @unique

  @@unique([telegram_id, friend_id])
}
